# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# OTP
# In production, plug a real SMS provider (Twilio/MSG91/etc.) into
# src/services/smsProvider.js. Until that's wired in, OTPs are only
# logged server-side and (if DEV_OTP_ECHO=true) returned in the API
# response so you can test end-to-end without an SMS account.
DEV_OTP_ECHO=true

# Weather (Open-Meteo needs no API key; kept here so a paid provider
# can be swapped in later without touching the frontend)
WEATHER_PROVIDER=open-meteo

# AI Provider
# Required for Thatha AI functionality. Get an API key from Google AI Studio.
GEMINI_API_KEY=
